[serial]

# Port number
portnum = 4

# Port baudrate
baudrate = 115200

# PicoScope serial numbers
# Two different serials → two oscilloscopes (channel A on each).
# One serial / second empty / both equal → one oscilloscope, A=I, B=V.
# Both empty → open the first detected unit.
scope_voltage = sn1
scope_current = sn2
